{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignLab legacy audit snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "artifact_inventory",
    "dataset_snapshot",
    "live_state",
    "reported_label_order",
    "reported_runs",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "commit_timestamp",
        "head_commit",
        "identification_anchor",
        "remotes",
        "recovery",
        "tags",
        "tree_object",
        "tracked_files",
        "worktree"
      ],
      "properties": {
        "branch": { "type": "string" },
        "commit_timestamp": { "type": "string" },
        "head_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "identification_anchor": { "type": "string" },
        "remotes": { "type": "array", "items": { "type": "string" } },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_locator", "code_locator", "limitation", "status"],
          "properties": {
            "artifact_locator": { "type": "string" },
            "code_locator": { "type": "string" },
            "limitation": { "type": "string" },
            "status": { "const": "incomplete-local-only" }
          }
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "tree_object": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tracked_files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bytecode_files", "file_count", "python_source_files"],
          "properties": {
            "bytecode_files": { "type": "integer", "minimum": 0 },
            "file_count": { "type": "integer", "minimum": 0 },
            "python_source_files": { "type": "integer", "minimum": 0 }
          }
        },
        "worktree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["modified_files", "untracked_files", "untracked_note"],
          "properties": {
            "modified_files": { "type": "integer", "minimum": 0 },
            "untracked_files": { "type": "integer", "minimum": 0 },
            "untracked_note": { "type": "string" }
          }
        }
      }
    },
    "artifact_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bytes", "file_count", "logical_path", "policy"],
        "properties": {
          "bytes": { "type": "integer", "minimum": 0 },
          "file_count": { "type": "integer", "minimum": 0 },
          "logical_path": { "type": "string" },
          "policy": { "type": "string" }
        }
      }
    },
    "dataset_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labels",
        "negative_material",
        "reported_split",
        "selected_representation",
        "sequence_length",
        "total_samples"
      ],
      "properties": {
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hello", "no", "please", "thank you", "yes"],
          "properties": {
            "hello": { "type": "integer", "minimum": 0 },
            "no": { "type": "integer", "minimum": 0 },
            "please": { "type": "integer", "minimum": 0 },
            "thank you": { "type": "integer", "minimum": 0 },
            "yes": { "type": "integer", "minimum": 0 }
          }
        },
        "negative_material": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "derived_landmark_files",
            "included_in_reported_five_class_runs",
            "raw_video_files"
          ],
          "properties": {
            "derived_landmark_files": { "type": "integer", "minimum": 0 },
            "included_in_reported_five_class_runs": { "type": "boolean" },
            "raw_video_files": { "type": "integer", "minimum": 0 }
          }
        },
        "reported_split": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "random_state",
            "test_fraction",
            "test_samples",
            "train_fraction",
            "train_samples",
            "validation_fraction",
            "validation_samples"
          ],
          "properties": {
            "method": { "type": "string" },
            "random_state": { "type": "integer" },
            "test_fraction": { "type": "number" },
            "test_samples": { "type": "integer", "minimum": 0 },
            "train_fraction": { "type": "number" },
            "train_samples": { "type": "integer", "minimum": 0 },
            "validation_fraction": { "type": "number" },
            "validation_samples": { "type": "integer", "minimum": 0 }
          }
        },
        "selected_representation": { "type": "string" },
        "sequence_length": { "type": "integer", "minimum": 1 },
        "total_samples": { "type": "integer", "minimum": 0 }
      }
    },
    "live_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feedback_database", "live_evaluation_database", "run_database"],
      "properties": {
        "feedback_database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["detections", "feedback_records", "sessions"],
          "properties": {
            "detections": { "type": "integer", "minimum": 0 },
            "feedback_records": { "type": "integer", "minimum": 0 },
            "sessions": { "type": "integer", "minimum": 0 }
          }
        },
        "live_evaluation_database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attempts", "replay_results"],
          "properties": {
            "attempts": { "type": "integer", "minimum": 0 },
            "replay_results": { "type": "integer", "minimum": 0 }
          }
        },
        "run_database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["by_model", "by_status", "runs"],
          "properties": {
            "by_model": {
              "type": "object",
              "additionalProperties": false,
              "required": ["causal_gru", "causal_lstm", "causal_tcn", "mamba"],
              "properties": {
                "causal_gru": { "type": "integer", "minimum": 0 },
                "causal_lstm": { "type": "integer", "minimum": 0 },
                "causal_tcn": { "type": "integer", "minimum": 0 },
                "mamba": { "type": "integer", "minimum": 0 }
              }
            },
            "by_status": {
              "type": "object",
              "additionalProperties": false,
              "required": ["failed", "running", "succeeded"],
              "properties": {
                "failed": { "type": "integer", "minimum": 0 },
                "running": { "type": "integer", "minimum": 0 },
                "succeeded": { "type": "integer", "minimum": 0 }
              }
            },
            "runs": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "reported_label_order": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "reported_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "confusion_matrix",
          "correct_test_predictions",
          "live_imported",
          "macro_f1",
          "model_bytes",
          "model_key",
          "model_logical_path",
          "model_sha256",
          "run_id",
          "source_evidence",
          "test_accuracy",
          "test_samples",
          "train_accuracy",
          "validation_accuracy"
        ],
        "properties": {
          "confusion_matrix": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "integer", "minimum": 0 }
            }
          },
          "correct_test_predictions": { "type": "integer", "minimum": 0 },
          "live_imported": { "type": "boolean" },
          "macro_f1": { "type": "number" },
          "model_bytes": { "type": "integer", "minimum": 0 },
          "model_key": { "type": "string" },
          "model_logical_path": { "type": "string" },
          "model_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "run_id": { "type": "string" },
          "source_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["bytes", "logical_path", "sha256"],
              "properties": {
                "bytes": { "type": "integer", "minimum": 0 },
                "logical_path": { "type": "string" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          },
          "test_accuracy": { "type": "number" },
          "test_samples": { "type": "integer", "minimum": 0 },
          "train_accuracy": { "type": "number" },
          "validation_accuracy": { "type": "number" }
        }
      }
    },
    "integrity": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bytes", "logical_path", "sha256"],
        "properties": {
          "bytes": { "type": "integer", "minimum": 0 },
          "logical_path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
