{
  "$comment": "This JSON Schema enforces portable structure and expressible local invariants. SignLab Pydantic and application validation remains authoritative for canonical digests, timestamp ordering, DAG closure, cross-record bindings, event-log completeness, cross-field locator equality, and withdrawal closure.",
  "$defs": {
    "TaxonomyRef": {
      "additionalProperties": false,
      "description": "Portable identity embedded in downstream manifests and bundles.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": "taxonomy-reference/1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "version",
        "sha256"
      ],
      "title": "TaxonomyRef",
      "type": "object"
    }
  },
  "$id": "https://signlab.dev/schemas/governance-asset-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "parent_asset_ids": {
            "minItems": 1,
            "uniqueItems": true
          }
        }
      },
      "if": {
        "properties": {
          "asset_kind": {
            "const": "raw_recording"
          }
        },
        "required": [
          "asset_kind"
        ]
      },
      "then": {
        "properties": {
          "grant_ids": {
            "maxItems": 1,
            "uniqueItems": true
          },
          "parent_asset_ids": {
            "maxItems": 0,
            "uniqueItems": true
          },
          "participant_ids": {
            "maxItems": 1,
            "uniqueItems": true
          },
          "receipt_ids": {
            "maxItems": 1,
            "uniqueItems": true
          },
          "recording_ids": {
            "maxItems": 1,
            "uniqueItems": true
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "invalidated_at": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "lifecycle_state": {
            "const": "invalidated"
          }
        },
        "required": [
          "lifecycle_state"
        ]
      },
      "then": {
        "properties": {
          "invalidated_at": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "asset_kind": {
            "const": "raw_recording"
          }
        },
        "required": [
          "asset_kind"
        ]
      },
      "then": {
        "properties": {
          "logical_uri": {
            "pattern": "^signlab://store-[0-9a-f]{32}/raw_recording/asset_[0-9a-f]{32}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "asset_kind": {
            "const": "backup_copy"
          }
        },
        "required": [
          "asset_kind"
        ]
      },
      "then": {
        "properties": {
          "logical_uri": {
            "pattern": "^signlab://store-[0-9a-f]{32}/backup_copy/asset_[0-9a-f]{32}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "asset_kind": {
            "const": "cache"
          }
        },
        "required": [
          "asset_kind"
        ]
      },
      "then": {
        "properties": {
          "logical_uri": {
            "pattern": "^signlab://store-[0-9a-f]{32}/cache/asset_[0-9a-f]{32}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "asset_kind": {
            "const": "derived_features"
          }
        },
        "required": [
          "asset_kind"
        ]
      },
      "then": {
        "properties": {
          "logical_uri": {
            "pattern": "^signlab://store-[0-9a-f]{32}/derived_features/asset_[0-9a-f]{32}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "asset_kind": {
            "const": "annotation"
          }
        },
        "required": [
          "asset_kind"
        ]
      },
      "then": {
        "properties": {
          "logical_uri": {
            "pattern": "^signlab://store-[0-9a-f]{32}/annotation/asset_[0-9a-f]{32}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "asset_kind": {
            "const": "dataset_version"
          }
        },
        "required": [
          "asset_kind"
        ]
      },
      "then": {
        "properties": {
          "logical_uri": {
            "pattern": "^signlab://store-[0-9a-f]{32}/dataset_version/asset_[0-9a-f]{32}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "asset_kind": {
            "const": "split_version"
          }
        },
        "required": [
          "asset_kind"
        ]
      },
      "then": {
        "properties": {
          "logical_uri": {
            "pattern": "^signlab://store-[0-9a-f]{32}/split_version/asset_[0-9a-f]{32}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "asset_kind": {
            "const": "experiment_run"
          }
        },
        "required": [
          "asset_kind"
        ]
      },
      "then": {
        "properties": {
          "logical_uri": {
            "pattern": "^signlab://store-[0-9a-f]{32}/experiment_run/asset_[0-9a-f]{32}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "asset_kind": {
            "const": "model_artifact"
          }
        },
        "required": [
          "asset_kind"
        ]
      },
      "then": {
        "properties": {
          "logical_uri": {
            "pattern": "^signlab://store-[0-9a-f]{32}/model_artifact/asset_[0-9a-f]{32}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "asset_kind": {
            "const": "evaluation_report"
          }
        },
        "required": [
          "asset_kind"
        ]
      },
      "then": {
        "properties": {
          "logical_uri": {
            "pattern": "^signlab://store-[0-9a-f]{32}/evaluation_report/asset_[0-9a-f]{32}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "asset_kind": {
            "const": "public_demo"
          }
        },
        "required": [
          "asset_kind"
        ]
      },
      "then": {
        "properties": {
          "logical_uri": {
            "pattern": "^signlab://store-[0-9a-f]{32}/public_demo/asset_[0-9a-f]{32}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "asset_kind": {
            "const": "withdrawal_tombstone"
          }
        },
        "required": [
          "asset_kind"
        ]
      },
      "then": {
        "properties": {
          "logical_uri": {
            "pattern": "^signlab://store-[0-9a-f]{32}/withdrawal_tombstone/asset_[0-9a-f]{32}$"
          }
        }
      }
    }
  ],
  "description": "One content-addressed lineage node affected by consent withdrawal.",
  "properties": {
    "asset_id": {
      "pattern": "^asset_[0-9a-f]{32}$",
      "title": "Asset Id",
      "type": "string"
    },
    "asset_kind": {
      "enum": [
        "raw_recording",
        "backup_copy",
        "cache",
        "derived_features",
        "annotation",
        "dataset_version",
        "split_version",
        "experiment_run",
        "model_artifact",
        "evaluation_report",
        "public_demo",
        "withdrawal_tombstone"
      ],
      "title": "Asset Kind",
      "type": "string"
    },
    "created_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Created At",
      "type": "string"
    },
    "grant_ids": {
      "items": {
        "pattern": "^grant_[0-9a-f]{32}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Grant Ids",
      "type": "array",
      "uniqueItems": true
    },
    "invalidated_at": {
      "anyOf": [
        {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Invalidated At"
    },
    "lifecycle_state": {
      "enum": [
        "active",
        "invalidation_pending",
        "invalidated"
      ],
      "title": "Lifecycle State",
      "type": "string"
    },
    "logical_uri": {
      "maxLength": 512,
      "minLength": 12,
      "pattern": "^signlab://store-[0-9a-f]{32}/(?:raw_recording|backup_copy|cache|derived_features|annotation|dataset_version|split_version|experiment_run|model_artifact|evaluation_report|public_demo|withdrawal_tombstone)/asset_[0-9a-f]{32}$",
      "title": "Logical Uri",
      "type": "string"
    },
    "parent_asset_ids": {
      "items": {
        "pattern": "^asset_[0-9a-f]{32}$",
        "type": "string"
      },
      "title": "Parent Asset Ids",
      "type": "array",
      "uniqueItems": true
    },
    "participant_ids": {
      "items": {
        "pattern": "^participant_[0-9a-f]{32}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Participant Ids",
      "type": "array",
      "uniqueItems": true
    },
    "receipt_ids": {
      "items": {
        "pattern": "^receipt_[0-9a-f]{32}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Receipt Ids",
      "type": "array",
      "uniqueItems": true
    },
    "recording_ids": {
      "items": {
        "pattern": "^recording_[0-9a-f]{32}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Recording Ids",
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "governance-asset/1",
      "title": "Schema Version",
      "type": "string"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "taxonomy": {
      "$ref": "#/$defs/TaxonomyRef"
    }
  },
  "required": [
    "schema_version",
    "asset_id",
    "asset_kind",
    "logical_uri",
    "sha256",
    "taxonomy",
    "created_at",
    "participant_ids",
    "recording_ids",
    "receipt_ids",
    "grant_ids",
    "parent_asset_ids",
    "lifecycle_state",
    "invalidated_at"
  ],
  "title": "GovernanceAssetV1",
  "type": "object"
}
