{
  "$comment": "This JSON Schema enforces portable structure and expressible local invariants. SignLab Pydantic and application validation remains authoritative for canonical digests, timestamp ordering, DAG closure, cross-record bindings, event-log completeness, cross-field locator equality, and withdrawal closure.",
  "$id": "https://signlab.dev/schemas/governance-document-reference-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable reference to a reviewed governance document, never its signatures.",
  "oneOf": [
    {
      "properties": {
        "document_id": {
          "const": "document_00000000000000000000000000000001"
        },
        "document_type": {
          "const": "consent_form"
        },
        "effective_at": {
          "const": "2026-08-26T00:00:00Z"
        },
        "sha256": {
          "const": "sha256:5ec3cad0f28d407f90278f61dc9f56457ce65ec7ae732c9afa7a26770ef05417"
        },
        "uri": {
          "const": "signlab://governance/consent-form/1.0.0"
        },
        "version": {
          "const": "1.0.0"
        }
      },
      "required": [
        "document_type",
        "document_id",
        "version",
        "effective_at",
        "uri",
        "sha256"
      ]
    },
    {
      "properties": {
