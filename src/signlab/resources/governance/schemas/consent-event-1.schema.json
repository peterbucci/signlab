{
  "$comment": "This JSON Schema enforces portable structure and expressible local invariants. SignLab Pydantic and application validation remains authoritative for canonical digests, timestamp ordering, DAG closure, cross-record bindings, event-log completeness, cross-field locator equality, and withdrawal closure.",
  "$id": "https://signlab.dev/schemas/consent-event-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "granted"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "reason_code": {
            "const": null
          },
          "replacement_receipt_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "withdrawn"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "reason_code": {
            "const": "participant_request"
          },
          "replacement_receipt_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "expired"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "reason_code": {
            "const": "consent_expired"
          },
          "replacement_receipt_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "superseded"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "reason_code": {
            "enum": [
              "policy_replaced",
              "scope_replaced"
            ]
          },
          "replacement_receipt_id": {
            "pattern": "^receipt_[0-9a-f]{32}$",
            "type": "string"
          }
        }
      }
    }
  ],
  "description": "Append-only consent lifecycle event without identity or free-text fields.",
  "properties": {
    "event_id": {
      "pattern": "^event_[0-9a-f]{32}$",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "enum": [
        "granted",
        "withdrawn",
        "expired",
        "superseded"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "occurred_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Occurred At",
      "type": "string"
    },
    "participant_id": {
      "pattern": "^participant_[0-9a-f]{32}$",
      "title": "Participant Id",
      "type": "string"
    },
    "reason_code": {
      "anyOf": [
        {
          "enum": [
            "participant_request",
            "consent_expired",
            "scope_replaced",
            "policy_replaced"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reason Code"
    },
    "receipt_id": {
      "pattern": "^receipt_[0-9a-f]{32}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "replacement_receipt_id": {
      "anyOf": [
        {
          "pattern": "^receipt_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Replacement Receipt Id"
    },
    "schema_version": {
      "const": "consent-event/1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Scope Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "receipt_id",
    "participant_id",
    "event_type",
    "occurred_at",
    "scope_sha256",
    "reason_code",
    "replacement_receipt_id"
  ],
  "title": "ConsentEventV1",
  "type": "object"
}
