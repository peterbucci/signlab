{
  "$comment": "This JSON Schema enforces portable structure and expressible local invariants. SignLab Pydantic and application validation remains authoritative for canonical digests, timestamp ordering, DAG closure, cross-record bindings, event-log completeness, cross-field locator equality, and withdrawal closure.",
  "$defs": {
    "WithdrawalImpactV1": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "planned_actions": {
                "contains": {
                  "const": "invalidate"
                },
                "not": {
                  "contains": {
                    "const": "retain"
                  }
                },
                "uniqueItems": true
              }
            }
          },
          "if": {
            "properties": {
              "asset_kind": {
                "const": "withdrawal_tombstone"
              }
            },
            "required": [
              "asset_kind"
            ]
          },
          "then": {
            "properties": {
              "planned_actions": {
                "const": [
                  "retain"
                ],
                "uniqueItems": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "asset_kind": {
                "const": "raw_recording"
              }
            },
            "required": [
              "asset_kind"
            ]
          },
          "then": {
            "properties": {
              "logical_uri": {
                "pattern": "^signlab://store-[0-9a-f]{32}/raw_recording/asset_[0-9a-f]{32}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "asset_kind": {
                "const": "backup_copy"
              }
            },
            "required": [
              "asset_kind"
            ]
          },
          "then": {
            "properties": {
              "logical_uri": {
                "pattern": "^signlab://store-[0-9a-f]{32}/backup_copy/asset_[0-9a-f]{32}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "asset_kind": {
                "const": "cache"
              }
            },
            "required": [
              "asset_kind"
            ]
          },
          "then": {
            "properties": {
              "logical_uri": {
                "pattern": "^signlab://store-[0-9a-f]{32}/cache/asset_[0-9a-f]{32}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "asset_kind": {
                "const": "derived_features"
              }
            },
            "required": [
              "asset_kind"
            ]
          },
          "then": {
            "properties": {
              "logical_uri": {
                "pattern": "^signlab://store-[0-9a-f]{32}/derived_features/asset_[0-9a-f]{32}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "asset_kind": {
                "const": "annotation"
              }
            },
            "required": [
              "asset_kind"
            ]
          },
          "then": {
            "properties": {
              "logical_uri": {
                "pattern": "^signlab://store-[0-9a-f]{32}/annotation/asset_[0-9a-f]{32}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "asset_kind": {
                "const": "dataset_version"
              }
            },
            "required": [
              "asset_kind"
            ]
          },
          "then": {
            "properties": {
              "logical_uri": {
                "pattern": "^signlab://store-[0-9a-f]{32}/dataset_version/asset_[0-9a-f]{32}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "asset_kind": {
                "const": "split_version"
              }
            },
            "required": [
              "asset_kind"
            ]
          },
          "then": {
            "properties": {
              "logical_uri": {
                "pattern": "^signlab://store-[0-9a-f]{32}/split_version/asset_[0-9a-f]{32}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "asset_kind": {
                "const": "experiment_run"
              }
            },
            "required": [
              "asset_kind"
            ]
          },
          "then": {
            "properties": {
              "logical_uri": {
                "pattern": "^signlab://store-[0-9a-f]{32}/experiment_run/asset_[0-9a-f]{32}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "asset_kind": {
                "const": "model_artifact"
              }
            },
            "required": [
              "asset_kind"
            ]
          },
          "then": {
            "properties": {
              "logical_uri": {
                "pattern": "^signlab://store-[0-9a-f]{32}/model_artifact/asset_[0-9a-f]{32}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "asset_kind": {
                "const": "evaluation_report"
              }
            },
            "required": [
              "asset_kind"
            ]
          },
          "then": {
            "properties": {
              "logical_uri": {
                "pattern": "^signlab://store-[0-9a-f]{32}/evaluation_report/asset_[0-9a-f]{32}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "asset_kind": {
                "const": "public_demo"
              }
            },
            "required": [
              "asset_kind"
            ]
          },
          "then": {
            "properties": {
              "logical_uri": {
                "pattern": "^signlab://store-[0-9a-f]{32}/public_demo/asset_[0-9a-f]{32}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "asset_kind": {
                "const": "withdrawal_tombstone"
              }
            },
            "required": [
              "asset_kind"
            ]
          },
          "then": {
            "properties": {
              "logical_uri": {
                "pattern": "^signlab://store-[0-9a-f]{32}/withdrawal_tombstone/asset_[0-9a-f]{32}$"
              }
            }
          }
        }
      ],
      "description": "One planned dry-run consequence; it never performs deletion itself.",
      "properties": {
        "asset_id": {
          "pattern": "^asset_[0-9a-f]{32}$",
          "title": "Asset Id",
          "type": "string"
        },
        "asset_kind": {
          "enum": [
            "raw_recording",
            "backup_copy",
            "cache",
            "derived_features",
            "annotation",
            "dataset_version",
            "split_version",
            "experiment_run",
            "model_artifact",
            "evaluation_report",
            "public_demo",
            "withdrawal_tombstone"
          ],
          "title": "Asset Kind",
          "type": "string"
        },
        "asset_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Asset Sha256",
          "type": "string"
        },
        "impact_id": {
          "pattern": "^impact_[0-9a-f]{32}$",
          "title": "Impact Id",
          "type": "string"
        },
        "impact_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Impact Sha256",
          "type": "string"
        },
        "logical_uri": {
          "maxLength": 512,
          "minLength": 12,
          "pattern": "^signlab://store-[0-9a-f]{32}/(?:raw_recording|backup_copy|cache|derived_features|annotation|dataset_version|split_version|experiment_run|model_artifact|evaluation_report|public_demo|withdrawal_tombstone)/asset_[0-9a-f]{32}$",
          "title": "Logical Uri",
          "type": "string"
        },
        "planned_actions": {
          "items": {
            "enum": [
              "delete_backups",
              "delete_primary",
              "invalidate",
              "purge_backup",
              "rebuild",
              "reevaluate",
              "remove_public_copy",
              "republish",
              "rerun",
              "retire",
              "retract",
              "retain",
              "retrain",
              "revoke_access"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Planned Actions",
          "type": "array",
          "uniqueItems": true
        },
        "relationship": {
          "enum": [
            "direct",
            "downstream"
          ],
          "title": "Relationship",
          "type": "string"
        },
        "schema_version": {
          "const": "withdrawal-impact/1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "impact_id",
        "asset_id",
        "logical_uri",
        "asset_sha256",
        "asset_kind",
        "relationship",
        "planned_actions",
        "impact_sha256"
      ],
      "title": "WithdrawalImpactV1",
      "type": "object"
    },
    "WithdrawalRequestV1": {
      "additionalProperties": false,
      "description": "A pseudonymous, whole-participant withdrawal request.",
      "properties": {
        "effective_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Effective At",
          "type": "string"
        },
        "identity_verification_attestation_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Identity Verification Attestation Sha256",
          "type": "string"
        },
        "participant_id": {
          "pattern": "^participant_[0-9a-f]{32}$",
          "title": "Participant Id",
          "type": "string"
        },
        "receipt_ids": {
          "items": {
            "pattern": "^receipt_[0-9a-f]{32}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Receipt Ids",
          "type": "array",
          "uniqueItems": true
        },
        "request_id": {
          "pattern": "^withdrawal_[0-9a-f]{32}$",
          "title": "Request Id",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "requested_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Requested At",
          "type": "string"
        },
        "schema_version": {
          "const": "withdrawal-request/1",
          "title": "Schema Version",
          "type": "string"
        },
        "target": {
          "const": "all_participant_data",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "participant_id",
        "receipt_ids",
        "requested_at",
        "effective_at",
        "target",
        "identity_verification_attestation_sha256",
        "request_sha256"
      ],
      "title": "WithdrawalRequestV1",
      "type": "object"
    }
  },
  "$id": "https://signlab.dev/schemas/withdrawal-report-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "if": {
        "properties": {
          "unresolved_asset_ids": {
            "maxItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "unresolved_asset_ids"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "complete"
          }
        }
      }
    }
  ],
  "description": "Verified output of a withdrawal dry run, without destructive side effects.",
  "properties": {
    "affected_asset_count": {
      "minimum": 0,
      "title": "Affected Asset Count",
      "type": "integer"
    },
    "direct_asset_count": {
      "minimum": 0,
      "title": "Direct Asset Count",
      "type": "integer"
    },
    "downstream_asset_count": {
      "minimum": 0,
      "title": "Downstream Asset Count",
      "type": "integer"
    },
    "generated_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Generated At",
      "type": "string"
    },
    "impacts": {
      "items": {
        "$ref": "#/$defs/WithdrawalImpactV1"
      },
      "title": "Impacts",
      "type": "array",
      "uniqueItems": true
    },
    "inventory_id": {
      "pattern": "^inventory_[0-9a-f]{32}$",
      "title": "Inventory Id",
      "type": "string"
    },
    "inventory_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Inventory Sha256",
      "type": "string"
    },
    "mode": {
      "const": "dry_run",
      "title": "Mode",
      "type": "string"
    },
    "report_id": {
      "pattern": "^report_[0-9a-f]{32}$",
      "title": "Report Id",
      "type": "string"
    },
    "report_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Report Sha256",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/WithdrawalRequestV1"
    },
    "schema_version": {
      "const": "withdrawal-report/1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "blocked",
        "complete"
      ],
      "title": "Status",
      "type": "string"
    },
    "unresolved_asset_ids": {
      "items": {
        "pattern": "^asset_[0-9a-f]{32}$",
        "type": "string"
      },
      "title": "Unresolved Asset Ids",
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "report_id",
    "mode",
    "request",
    "inventory_id",
    "inventory_sha256",
    "generated_at",
    "status",
    "impacts",
    "affected_asset_count",
    "direct_asset_count",
    "downstream_asset_count",
    "unresolved_asset_ids",
    "report_sha256"
  ],
  "title": "WithdrawalReportV1",
  "type": "object"
}
