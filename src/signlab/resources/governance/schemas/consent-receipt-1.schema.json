              "const": "withdrawal_procedure"
            },
            "effective_at": {
              "const": "2026-08-26T00:00:00Z"
            },
            "sha256": {
              "const": "sha256:d583a387d2debfcb1c49746cfa51a32f694e39410c6bd900c3a292a090cb8075"
            },
            "uri": {
              "const": "signlab://governance/withdrawal-runbook/1.0.0"
            },
            "version": {
              "const": "1.0.0"
