      "properties": {
        "document_id": {
          "pattern": "^document_[0-9a-f]{32}$",
          "title": "Document Id",
          "type": "string"
        },
        "document_type": {
          "enum": [
            "consent_form",
            "privacy_notice",
            "governance_policy",
            "withdrawal_procedure"
          ],
          "title": "Document Type",
          "type": "string"
        },
        "effective_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Effective At",
          "type": "string"
        },
        "schema_version": {
          "const": "document-reference/1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "maxLength": 512,
          "minLength": 12,
          "title": "Uri",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "document_id",
        "document_type",
        "version",
        "effective_at",
        "uri",
        "sha256"
      ],
      "title": "DocumentRef",
      "type": "object"
