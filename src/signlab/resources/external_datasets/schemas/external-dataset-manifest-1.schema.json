{
  "$comment": "This JSON Schema enforces portable structure. SignLab's strict external-data validators remain authoritative for canonical hashes, immutable resource bindings, label mappings, archive ordering, signer split isolation, license boundaries, and artifact-byte verification.",
  "$defs": {
    "ExternalArchiveRecordV1": {
      "additionalProperties": false,
      "description": "Exact local identity and aggregate evidence for one imported archive.",
      "properties": {
        "archive_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Archive Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "game",
            "non-game"
          ],
          "title": "Category",
          "type": "string"
        },
        "integrity_basis": {
          "const": "local_sha256_after_download",
          "title": "Integrity Basis",
          "type": "string"
        },
        "local_archive": {
          "$ref": "#/$defs/WorkspaceRelativeLocatorV1"
        },
        "member_count": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Member Count",
          "type": "integer"
        },
        "publisher_checksum_available": {
          "const": false,
          "title": "Publisher Checksum Available",
          "type": "boolean"
        },
        "schema_version": {
          "const": "external-archive-record/1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source_label": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Source Label",
          "type": "string"
        },
        "split": {
          "enum": [
            "train",
            "val",
            "test"
          ],
          "title": "Split",
          "type": "string"
        },
        "uncompressed_size_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Uncompressed Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "archive_id",
        "category",
        "split",
        "source_label",
        "local_archive",
        "sha256",
        "size_bytes",
        "member_count",
        "uncompressed_size_bytes",
        "publisher_checksum_available",
        "integrity_basis"
      ],
      "title": "ExternalArchiveRecordV1",
      "type": "object"
    },
    "ExternalLicenseAcknowledgementV1": {
      "additionalProperties": false,
      "description": "Explicit dataset-license acknowledgement without a consent claim.",
      "properties": {
        "accepted": {
          "const": true,
          "title": "Accepted",
          "type": "boolean"
        },
        "authorization_basis": {
          "const": "licensed_public_dataset",
          "title": "Authorization Basis",
          "type": "string"
        },
        "license_id": {
          "const": "CC-BY-4.0",
          "title": "License Id",
          "type": "string"
        },
        "schema_version": {
          "const": "external-license-acknowledgement/1",
          "title": "Schema Version",
          "type": "string"
        },
        "signlab_participant_consent": {
          "const": "not_applicable",
          "title": "Signlab Participant Consent",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "license_id",
        "accepted",
        "authorization_basis",
        "signlab_participant_consent"
      ],
      "title": "ExternalLicenseAcknowledgementV1",
      "type": "object"
    },
    "ExternalMediaRecordV1": {
      "additionalProperties": false,
      "description": "One copied media member with opaque identity and no upstream filename.",
      "properties": {
        "archive_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Archive Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "game",
            "non-game"
          ],
          "title": "Category",
          "type": "string"
        },
        "eligible_for_extraction": {
          "const": true,
          "title": "Eligible For Extraction",
          "type": "boolean"
        },
        "locator": {
          "$ref": "#/$defs/WorkspaceRelativeLocatorV1"
        },
        "media_type": {
          "const": "video/mp4",
          "title": "Media Type",
          "type": "string"
        },
        "participant_id": {
          "pattern": "^participant_[0-9a-f]{32}$",
          "title": "Participant Id",
          "type": "string"
        },
        "recording_id": {
          "pattern": "^recording_[0-9a-f]{32}$",
          "title": "Recording Id",
          "type": "string"
        },
        "sample_id": {
          "pattern": "^sample_[0-9a-f]{32}$",
          "title": "Sample Id",
          "type": "string"
        },
        "schema_version": {
          "const": "external-media-record/1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source_label": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Source Label",
          "type": "string"
        },
        "source_member_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Member Fingerprint",
          "type": "string"
        },
        "source_split": {
          "enum": [
            "train",
            "val",
            "test"
          ],
          "title": "Source Split",
          "type": "string"
        },
        "target_label_id": {
          "enum": [
            "hello",
            "no",
            "please",
            "thank_you",
            "yes"
          ],
          "title": "Target Label Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "sample_id",
        "recording_id",
        "participant_id",
        "archive_id",
        "source_member_fingerprint",
        "category",
        "source_split",
        "source_label",
        "target_label_id",
        "media_type",
        "sha256",
        "size_bytes",
        "locator",
        "eligible_for_extraction"
      ],
      "title": "ExternalMediaRecordV1",
      "type": "object"
    },
    "ExternalResourceRefV1": {
      "additionalProperties": false,
      "description": "Digest-bound reference to one immutable external-data resource.",
      "properties": {
        "resource_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Resource Id",
          "type": "string"
        },
        "resource_kind": {
          "enum": [
            "source",
            "selection"
          ],
          "title": "Resource Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "external-resource-reference/1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "resource_kind",
        "resource_id",
        "version",
        "sha256"
      ],
      "title": "ExternalResourceRefV1",
      "type": "object"
    },
    "TaxonomyRef": {
      "additionalProperties": false,
      "description": "Portable identity embedded in downstream manifests and bundles.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": "taxonomy-reference/1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "version",
        "sha256"
      ],
      "title": "TaxonomyRef",
      "type": "object"
    },
    "WorkspaceRelativeLocatorV1": {
      "additionalProperties": false,
      "description": "A normalized path interpreted only relative to an explicit workspace root.",
      "properties": {
        "kind": {
          "const": "workspace_relative",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "title": "WorkspaceRelativeLocatorV1",
      "type": "object"
    }
  },
  "$id": "https://signlab.dev/schemas/external-dataset-manifest-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "License-authorized raw external media, distinct from participant raw data.",
  "properties": {
    "acquisition_plan_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Acquisition Plan Sha256",
      "type": "string"
    },
    "archives": {
      "items": {
        "$ref": "#/$defs/ExternalArchiveRecordV1"
      },
      "maxItems": 4096,
      "minItems": 1,
      "title": "Archives",
      "type": "array",
      "uniqueItems": true
    },
    "claim_scope": {
      "const": "isolated_predefined_gesture_research_only",
      "title": "Claim Scope",
      "type": "string"
    },
    "contains_identifiable_human_video": {
      "const": true,
      "title": "Contains Identifiable Human Video",
      "type": "boolean"
    },
    "content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
      "title": "Dataset Id",
      "type": "string"
    },
    "license_acknowledgement": {
      "$ref": "#/$defs/ExternalLicenseAcknowledgementV1"
    },
    "media": {
      "items": {
        "$ref": "#/$defs/ExternalMediaRecordV1"
      },
      "maxItems": 1000000,
      "minItems": 1,
      "title": "Media",
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "external-dataset-manifest/1",
      "title": "Schema Version",
      "type": "string"
    },
    "selection": {
      "$ref": "#/$defs/ExternalResourceRefV1"
    },
    "source": {
      "$ref": "#/$defs/ExternalResourceRefV1"
    },
    "source_metadata_retained": {
      "const": false,
      "title": "Source Metadata Retained",
      "type": "boolean"
    },
    "taxonomy": {
      "$ref": "#/$defs/TaxonomyRef"
    },
    "version": {
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "dataset_id",
    "version",
    "source",
    "selection",
    "acquisition_plan_sha256",
    "taxonomy",
    "license_acknowledgement",
    "contains_identifiable_human_video",
    "source_metadata_retained",
    "claim_scope",
    "archives",
    "media",
    "content_sha256"
  ],
  "title": "ExternalDatasetManifestV1",
  "type": "object"
}
