{
  "$comment": "This JSON Schema enforces portable structure. SignLab's strict ingest validators remain authoritative for canonical hashes, ordering, state transitions, consent bindings, review projection, table relationships, and artifact-byte verification.",
  "$defs": {
    "AnnotationDecisionV1": {
      "additionalProperties": false,
      "description": "One immutable actor decision in an annotation review history.",
      "properties": {
        "actor_id": {
          "pattern": "^actor_[0-9a-f]{32}$",
          "title": "Actor Id",
          "type": "string"
        },
        "decided_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Decided At",
          "type": "string"
        },
        "decision_id": {
          "pattern": "^decision_[0-9a-f]{32}$",
          "title": "Decision Id",
          "type": "string"
        },
        "proposal": {
          "$ref": "#/$defs/AnnotationProposalV1"
        },
        "role": {
          "enum": [
            "annotator",
            "reviewer",
            "adjudicator"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": "annotation-decision/1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "decision_id",
        "actor_id",
        "role",
        "decided_at",
        "proposal"
      ],
      "title": "AnnotationDecisionV1",
      "type": "object"
    },
    "AnnotationProposalV1": {
      "additionalProperties": false,
      "description": "One coded, timestamped annotation proposal without free text.",
      "properties": {
        "disposition": {
          "enum": [
            "class_label",
            "ambiguous",
            "ignore"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "interval": {
          "$ref": "#/$defs/MediaIntervalV1"
        },
        "label_id": {
          "anyOf": [
            {
              "enum": [
                "hello",
                "no",
                "please",
                "thank_you",
                "yes",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Label Id"
        },
        "other_kind": {
          "anyOf": [
            {
              "enum": [
                "partial_target",
                "transition_fragment",
                "oov_gesture",
                "incidental_activity",
                "two_hand_non_target"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Other Kind"
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "unusable_occlusion",
                "boundary_unclear",
                "consent_exclusion",
                "camera_setup",
                "third_party_presence",
                "unresolved_conflict"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Code"
        },
        "schema_version": {
          "const": "annotation-proposal/1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "interval",
        "disposition",
        "label_id",
        "other_kind",
        "reason_code"
      ],
      "title": "AnnotationProposalV1",
      "type": "object"
    },
    "CaptureAnnotationV1": {
      "additionalProperties": false,
      "description": "An append-only annotation decision history for one accepted recording.",
      "properties": {
        "annotation_id": {
          "pattern": "^annotation_[0-9a-f]{32}$",
          "title": "Annotation Id",
          "type": "string"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/AnnotationDecisionV1"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Decisions",
          "type": "array",
          "uniqueItems": true
        },
        "schema_version": {
          "const": "capture-annotation/1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_recording_id": {
          "pattern": "^recording_[0-9a-f]{32}$",
          "title": "Source Recording Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "annotation_id",
        "source_recording_id",
        "decisions"
      ],
      "title": "CaptureAnnotationV1",
      "type": "object"
    },
    "CaptureAttemptV1": {
      "additionalProperties": false,
      "description": "One immutable capture result addressed only by opaque source identity.",
      "properties": {
        "attempt_id": {
          "pattern": "^attempt_[0-9a-f]{32}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "audio_present": {
          "const": false,
          "title": "Audio Present",
          "type": "boolean"
        },
        "consent_grant": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordingConsentGrantV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_us": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Duration Us",
          "type": "integer"
        },
        "expected_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Expected Sha256",
          "type": "string"
        },
        "expected_size_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Expected Size Bytes",
          "type": "integer"
        },
        "handedness": {
          "enum": [
            "left",
            "right",
            "both",
            "ambidextrous",
            "unknown"
          ],
          "title": "Handedness",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "video/mp4",
            "video/quicktime",
            "video/webm"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "mirror_state": {
          "enum": [
            "not_mirrored",
            "mirrored"
          ],
          "title": "Mirror State",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "accepted",
            "retry",
            "quarantined"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "camera_interruption",
                "prompt_display_failure",
                "third_party_presence",
                "framing_failure",
                "corrupt_source",
                "missing_source",
                "legacy_consent_unknown",
                "legacy_label_unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Code"
        },
        "recorded_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Recorded At",
          "type": "string"
        },
        "recording_id": {
          "pattern": "^recording_[0-9a-f]{32}$",
          "title": "Recording Id",
          "type": "string"
        },
        "retry_of_attempt_id": {
          "anyOf": [
            {
              "pattern": "^attempt_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retry Of Attempt Id"
        },
        "rotation_degrees": {
          "enum": [
            0,
            90,
            180,
            270
          ],
          "title": "Rotation Degrees",
          "type": "integer"
        },
        "schema_version": {
          "const": "capture-attempt/1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_key": {
          "pattern": "^source_[0-9a-f]{32}$",
          "title": "Source Key",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "attempt_id",
        "recording_id",
        "source_key",
        "outcome",
        "reason_code",
        "retry_of_attempt_id",
        "recorded_at",
        "media_type",
        "expected_sha256",
        "expected_size_bytes",
        "duration_us",
        "handedness",
        "mirror_state",
        "rotation_degrees",
        "audio_present",
        "consent_grant"
      ],
      "title": "CaptureAttemptV1",
      "type": "object"
    },
    "ChecklistResultV1": {
      "additionalProperties": false,
      "description": "One coded checklist result without notes or participant-identifying text.",
      "properties": {
        "check_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Check Id",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "synthetic_no_person_no_camera",
                "consent_unverified",
                "collection_not_ready",
                "purpose_not_authorized",
                "camera_unavailable",
                "framing_unusable",
                "third_party_presence",
                "orientation_unverified",
                "playback_unverified"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Code"
        },
        "schema_version": {
          "const": "checklist-result/1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "not_applicable",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "check_id",
        "status",
        "reason_code"
      ],
      "title": "ChecklistResultV1",
      "type": "object"
    },
    "CollectionProtocolRefV1": {
      "additionalProperties": false,
      "description": "Immutable identity of the reviewed protocol used for a collection.",
      "properties": {
        "protocol_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Protocol Id",
          "type": "string"
        },
        "schema_version": {
          "const": "collection-protocol-reference/1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "protocol_id",
        "version",
        "sha256"
      ],
      "title": "CollectionProtocolRefV1",
      "type": "object"
    },
    "CollectionSessionPlanV1": {
      "additionalProperties": false,
      "description": "Lean operational plan binding one visit and its reproducibility checklist.",
      "properties": {
        "capture_checklist": {
          "items": {
            "$ref": "#/$defs/ChecklistResultV1"
          },
          "minItems": 1,
          "title": "Capture Checklist",
          "type": "array",
          "uniqueItems": true
        },
        "condition_profile_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Condition Profile Id",
          "type": "string"
        },
        "consent_checklist": {
          "items": {
            "$ref": "#/$defs/ChecklistResultV1"
          },
          "minItems": 1,
          "title": "Consent Checklist",
          "type": "array",
          "uniqueItems": true
        },
        "prompt_randomization": {
          "$ref": "#/$defs/PromptRandomizationV1"
        },
        "schema_version": {
          "const": "collection-session-plan/1",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "pattern": "^session_[0-9a-f]{32}$",
          "title": "Session Id",
          "type": "string"
        },
        "visit_id": {
          "pattern": "^visit_[0-9a-f]{32}$",
          "title": "Visit Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "visit_id",
        "session_id",
        "condition_profile_id",
        "prompt_randomization",
        "consent_checklist",
        "capture_checklist"
      ],
      "title": "CollectionSessionPlanV1",
      "type": "object"
    },
    "ConsentScopeV1": {
      "additionalProperties": false,
      "description": "An explicit permission ceiling; every permission is required on the wire.",
      "properties": {
        "audio_collection": {
          "const": false,
          "title": "Audio Collection",
          "type": "boolean"
        },
        "commercial_sale": {
          "const": false,
          "title": "Commercial Sale",
          "type": "boolean"
        },
        "derived_features": {
          "title": "Derived Features",
          "type": "boolean"
        },
        "derived_features_redistribution": {
          "title": "Derived Features Redistribution",
          "type": "boolean"
        },
        "evaluation_results_redistribution": {
          "title": "Evaluation Results Redistribution",
          "type": "boolean"
        },
        "identity_inference": {
          "const": false,
          "title": "Identity Inference",
          "type": "boolean"
        },
        "minor_participation": {
          "const": false,
          "title": "Minor Participation",
          "type": "boolean"
        },
        "model_evaluation": {
          "title": "Model Evaluation",
          "type": "boolean"
        },
        "model_training": {
          "title": "Model Training",
          "type": "boolean"
        },
        "model_weights_redistribution": {
          "title": "Model Weights Redistribution",
          "type": "boolean"
        },
        "public_demonstration": {
          "title": "Public Demonstration",
          "type": "boolean"
        },
        "raw_media_capture": {
          "title": "Raw Media Capture",
          "type": "boolean"
        },
        "raw_media_redistribution": {
          "title": "Raw Media Redistribution",
          "type": "boolean"
        },
        "raw_media_retention": {
          "title": "Raw Media Retention",
          "type": "boolean"
        },
        "research_use": {
          "title": "Research Use",
          "type": "boolean"
        },
        "same_purpose_future_research": {
          "title": "Same Purpose Future Research",
          "type": "boolean"
        },
        "schema_version": {
          "const": "consent-scope/1",
          "title": "Schema Version",
          "type": "string"
        },
        "withdrawal_supported": {
          "const": true,
          "title": "Withdrawal Supported",
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "research_use",
        "raw_media_capture",
        "model_training",
        "model_evaluation",
        "public_demonstration",
        "model_weights_redistribution",
        "raw_media_retention",
        "raw_media_redistribution",
        "derived_features",
        "derived_features_redistribution",
        "evaluation_results_redistribution",
        "same_purpose_future_research",
        "withdrawal_supported",
        "audio_collection",
        "minor_participation",
        "identity_inference",
        "commercial_sale"
      ],
      "title": "ConsentScopeV1",
      "type": "object"
    },
    "DocumentRef": {
      "additionalProperties": false,
      "description": "Immutable reference to a reviewed governance document, never its signatures.",
      "properties": {
        "document_id": {
          "pattern": "^document_[0-9a-f]{32}$",
          "title": "Document Id",
          "type": "string"
        },
        "document_type": {
          "enum": [
            "consent_form",
            "privacy_notice",
            "governance_policy",
            "withdrawal_procedure"
          ],
          "title": "Document Type",
          "type": "string"
        },
        "effective_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Effective At",
          "type": "string"
        },
        "schema_version": {
          "const": "document-reference/1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "maxLength": 512,
          "minLength": 12,
          "title": "Uri",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "document_id",
        "document_type",
        "version",
        "effective_at",
        "uri",
        "sha256"
      ],
      "title": "DocumentRef",
      "type": "object"
    },
    "GovernancePolicyV1": {
      "additionalProperties": false,
      "description": "Reviewed access, retention, backup, deletion, and withdrawal rules.",
      "properties": {
        "access_audit_logged": {
          "const": true,
          "title": "Access Audit Logged",
          "type": "boolean"
        },
        "access_least_privilege": {
          "const": true,
          "title": "Access Least Privilege",
          "type": "boolean"
        },
        "backup_retention_days": {
          "minimum": 0,
          "title": "Backup Retention Days",
          "type": "integer"
        },
        "backups_encrypted": {
          "const": true,
          "title": "Backups Encrypted",
          "type": "boolean"
        },
        "backups_include_raw_media": {
          "title": "Backups Include Raw Media",
          "type": "boolean"
        },
        "deletion_includes_backups": {
          "const": true,
          "title": "Deletion Includes Backups",
          "type": "boolean"
        },
        "derived_feature_retention_days": {
          "exclusiveMinimum": 0,
          "title": "Derived Feature Retention Days",
          "type": "integer"
        },
        "effective_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Effective At",
          "type": "string"
        },
        "evaluation_result_retention_days": {
          "exclusiveMinimum": 0,
          "title": "Evaluation Result Retention Days",
          "type": "integer"
        },
        "permitted_roles": {
          "items": {
            "enum": [
              "data_steward",
              "model_operator",
              "release_reviewer",
              "researcher"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Permitted Roles",
          "type": "array"
        },
        "policy_document": {
          "$ref": "#/$defs/DocumentRef"
        },
        "policy_id": {
          "pattern": "^policy_[0-9a-f]{32}$",
          "title": "Policy Id",
          "type": "string"
        },
        "prohibited_uses": {
          "items": {
            "enum": [
              "audio_collection",
              "commercial_sale",
              "identity_inference",
              "minor_participation",
              "participant_level_public_ranking",
              "surveillance"
            ],
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Prohibited Uses",
          "type": "array"
        },
        "raw_media_retention_days": {
          "exclusiveMinimum": 0,
          "title": "Raw Media Retention Days",
          "type": "integer"
        },
        "raw_media_roles": {
          "items": {
            "enum": [
              "data_steward",
              "model_operator",
              "release_reviewer",
              "researcher"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Raw Media Roles",
          "type": "array"
        },
        "schema_version": {
          "const": "governance-policy/1",
          "title": "Schema Version",
          "type": "string"
        },
        "storage_encrypted": {
          "const": true,
          "title": "Storage Encrypted",
          "type": "boolean"
        },
        "taxonomy": {
          "$ref": "#/$defs/TaxonomyRef"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        },
        "withdrawal_impact_inventory_days": {
          "exclusiveMinimum": 0,
          "title": "Withdrawal Impact Inventory Days",
          "type": "integer"
        },
        "withdrawal_invalidates_downstream": {
          "const": true,
          "title": "Withdrawal Invalidates Downstream",
          "type": "boolean"
        },
        "withdrawal_procedure": {
          "$ref": "#/$defs/DocumentRef"
        },
        "withdrawal_response_days": {
          "exclusiveMinimum": 0,
          "title": "Withdrawal Response Days",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "policy_id",
        "version",
        "taxonomy",
        "policy_document",
        "withdrawal_procedure",
        "effective_at",
        "permitted_roles",
        "raw_media_roles",
        "raw_media_retention_days",
        "derived_feature_retention_days",
        "evaluation_result_retention_days",
        "backup_retention_days",
        "withdrawal_impact_inventory_days",
        "withdrawal_response_days",
        "storage_encrypted",
        "backups_encrypted",
        "backups_include_raw_media",
        "access_least_privilege",
        "access_audit_logged",
        "deletion_includes_backups",
        "withdrawal_invalidates_downstream",
        "prohibited_uses"
      ],
      "title": "GovernancePolicyV1",
      "type": "object"
    },
    "MediaIntervalV1": {
      "additionalProperties": false,
      "description": "A non-empty half-open interval in root-recording microseconds.",
      "properties": {
        "end_us": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "End Us",
          "type": "integer"
        },
        "schema_version": {
          "const": "media-interval/1",
          "title": "Schema Version",
          "type": "string"
        },
        "start_us": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Start Us",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "start_us",
        "end_us"
      ],
      "title": "MediaIntervalV1",
      "type": "object"
    },
    "ParticipantRowV1": {
      "additionalProperties": false,
      "description": "One pseudonymous participant without identity-vault attributes.",
      "properties": {
        "handedness": {
          "enum": [
            "left",
            "right",
            "both",
            "ambidextrous",
            "unknown"
          ],
          "title": "Handedness",
          "type": "string"
        },
        "participant_id": {
          "pattern": "^participant_[0-9a-f]{32}$",
          "title": "Participant Id",
          "type": "string"
        }
      },
      "required": [
        "participant_id",
        "handedness"
      ],
      "title": "ParticipantRowV1",
      "type": "object"
    },
    "PromptOccurrenceV1": {
      "additionalProperties": false,
      "description": "One preallocated protocol occurrence with its immutable attempt history.",
      "properties": {
        "attempts": {
          "items": {
            "$ref": "#/$defs/CaptureAttemptV1"
          },
          "title": "Attempts",
          "type": "array",
          "uniqueItems": true
        },
        "ordinal": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Ordinal",
          "type": "integer"
        },
        "participant_id": {
          "pattern": "^participant_[0-9a-f]{32}$",
          "title": "Participant Id",
          "type": "string"
        },
        "prompt_label_id": {
          "enum": [
            "hello",
            "no",
            "please",
            "thank_you",
            "yes",
            "other"
          ],
          "title": "Prompt Label Id",
          "type": "string"
        },
        "prompt_occurrence_id": {
          "pattern": "^occurrence_[0-9a-f]{32}$",
          "title": "Prompt Occurrence Id",
          "type": "string"
        },
        "repetition": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Repetition",
          "type": "integer"
        },
        "schema_version": {
          "const": "prompt-occurrence/1",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "pattern": "^session_[0-9a-f]{32}$",
          "title": "Session Id",
          "type": "string"
        },
        "skip_reason_code": {
          "anyOf": [
            {
              "enum": [
                "participant_skip",
                "session_stopped"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Skip Reason Code"
        },
        "state": {
          "enum": [
            "pending",
            "accepted",
            "quarantined",
            "skipped"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "prompt_occurrence_id",
        "ordinal",
        "repetition",
        "prompt_label_id",
        "participant_id",
        "session_id",
        "state",
        "skip_reason_code",
        "attempts"
      ],
      "title": "PromptOccurrenceV1",
      "type": "object"
    },
    "PromptRandomizationV1": {
      "additionalProperties": false,
      "description": "Reproducibility facts for one authoritative realized prompt order.",
      "properties": {
        "algorithm_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Algorithm Id",
          "type": "string"
        },
        "algorithm_version": {
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Algorithm Version",
          "type": "string"
        },
        "realized_order_authoritative": {
          "const": true,
          "title": "Realized Order Authoritative",
          "type": "boolean"
        },
        "rerolled_for_performance": {
          "const": false,
          "title": "Rerolled For Performance",
          "type": "boolean"
        },
        "schema_version": {
          "const": "prompt-randomization/1",
          "title": "Schema Version",
          "type": "string"
        },
        "seed_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Seed Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "algorithm_id",
        "algorithm_version",
        "seed_sha256",
        "realized_order_authoritative",
        "rerolled_for_performance"
      ],
      "title": "PromptRandomizationV1",
      "type": "object"
    },
    "RecordingConsentGrantV1": {
      "additionalProperties": false,
      "description": "The explicit, receipt-bounded consent scope attached to one recording.",
      "properties": {
        "captured_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Captured At",
          "type": "string"
        },
        "grant_id": {
          "pattern": "^grant_[0-9a-f]{32}$",
          "title": "Grant Id",
          "type": "string"
        },
        "issued_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Issued At",
          "type": "string"
        },
        "participant_id": {
          "pattern": "^participant_[0-9a-f]{32}$",
          "title": "Participant Id",
          "type": "string"
        },
        "purpose_id": {
          "pattern": "^purpose_[0-9a-f]{32}$",
          "title": "Purpose Id",
          "type": "string"
        },
        "receipt_id": {
          "pattern": "^receipt_[0-9a-f]{32}$",
          "title": "Receipt Id",
          "type": "string"
        },
        "receipt_scope_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Receipt Scope Sha256",
          "type": "string"
        },
        "recording_id": {
          "pattern": "^recording_[0-9a-f]{32}$",
          "title": "Recording Id",
          "type": "string"
        },
        "schema_version": {
          "const": "recording-consent-grant/1",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/ConsentScopeV1"
        },
        "scope_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Scope Sha256",
          "type": "string"
        },
        "study_id": {
          "pattern": "^study_[0-9a-f]{32}$",
          "title": "Study Id",
          "type": "string"
        },
        "taxonomy": {
          "$ref": "#/$defs/TaxonomyRef"
        }
      },
      "required": [
        "schema_version",
        "grant_id",
        "recording_id",
        "participant_id",
        "receipt_id",
        "purpose_id",
        "study_id",
        "taxonomy",
        "scope",
        "scope_sha256",
        "receipt_scope_sha256",
        "issued_at",
        "captured_at"
      ],
      "title": "RecordingConsentGrantV1",
      "type": "object"
    },
    "SessionRowV1": {
      "additionalProperties": false,
      "description": "One bounded capture session with non-identifying device facts.",
      "properties": {
        "camera_facing": {
          "enum": [
            "front",
            "rear",
            "external",
            "unknown"
          ],
          "title": "Camera Facing",
          "type": "string"
        },
        "capture_mode": {
          "enum": [
            "isolated",
            "continuous"
          ],
          "title": "Capture Mode",
          "type": "string"
        },
        "capture_software_version": {
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Capture Software Version",
          "type": "string"
        },
        "device_id": {
          "pattern": "^device_[0-9a-f]{32}$",
          "title": "Device Id",
          "type": "string"
        },
        "finished_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Finished At",
          "type": "string"
        },
        "frame_height_px": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Frame Height Px",
          "type": "integer"
        },
        "frame_rate_denominator": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Frame Rate Denominator",
          "type": "integer"
        },
        "frame_rate_numerator": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Frame Rate Numerator",
          "type": "integer"
        },
        "frame_width_px": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Frame Width Px",
          "type": "integer"
        },
        "mirror_state": {
          "enum": [
            "not_mirrored",
            "mirrored"
          ],
          "title": "Mirror State",
          "type": "string"
        },
        "participant_id": {
          "pattern": "^participant_[0-9a-f]{32}$",
          "title": "Participant Id",
          "type": "string"
        },
        "rotation_degrees": {
          "enum": [
            0,
            90,
            180,
            270
          ],
          "title": "Rotation Degrees",
          "type": "integer"
        },
        "session_id": {
          "pattern": "^session_[0-9a-f]{32}$",
          "title": "Session Id",
          "type": "string"
        },
        "started_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "participant_id",
        "device_id",
        "started_at",
        "finished_at",
        "capture_mode",
        "capture_software_version",
        "camera_facing",
        "frame_width_px",
        "frame_height_px",
        "frame_rate_numerator",
        "frame_rate_denominator",
        "rotation_degrees",
        "mirror_state"
      ],
      "title": "SessionRowV1",
      "type": "object"
    },
    "TaxonomyRef": {
      "additionalProperties": false,
      "description": "Portable identity embedded in downstream manifests and bundles.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": "taxonomy-reference/1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "version",
        "sha256"
      ],
      "title": "TaxonomyRef",
      "type": "object"
    }
  },
  "$id": "https://signlab.dev/schemas/collection-sidecar-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A resumable capture ledger and its immutable annotation decisions.",
  "properties": {
    "annotations": {
      "items": {
        "$ref": "#/$defs/CaptureAnnotationV1"
      },
      "title": "Annotations",
      "type": "array",
      "uniqueItems": true
    },
    "collection_id": {
      "pattern": "^collection_[0-9a-f]{32}$",
      "title": "Collection Id",
      "type": "string"
    },
    "collection_sidecar_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Collection Sidecar Sha256",
      "type": "string"
    },
    "dataset_id": {
      "pattern": "^dataset_[0-9a-f]{32}$",
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Dataset Version",
      "type": "string"
    },
    "finalized_at": {
      "anyOf": [
        {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Finalized At"
    },
    "fixture_only": {
      "title": "Fixture Only",
      "type": "boolean"
    },
    "generated_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Generated At",
      "type": "string"
    },
    "governance_policy": {
      "$ref": "#/$defs/GovernancePolicyV1"
    },
    "inventory_id": {
      "pattern": "^inventory_[0-9a-f]{32}$",
      "title": "Inventory Id",
      "type": "string"
    },
    "occurrences": {
      "items": {
        "$ref": "#/$defs/PromptOccurrenceV1"
      },
      "minItems": 1,
      "title": "Occurrences",
      "type": "array",
      "uniqueItems": true
    },
    "participants": {
      "items": {
        "$ref": "#/$defs/ParticipantRowV1"
      },
      "minItems": 1,
      "title": "Participants",
      "type": "array",
      "uniqueItems": true
    },
    "protocol": {
      "$ref": "#/$defs/CollectionProtocolRefV1"
    },
    "schema_version": {
      "const": "collection-sidecar/1",
      "title": "Schema Version",
      "type": "string"
    },
    "session_plans": {
      "items": {
        "$ref": "#/$defs/CollectionSessionPlanV1"
      },
      "minItems": 1,
      "title": "Session Plans",
      "type": "array",
      "uniqueItems": true
    },
    "sessions": {
      "items": {
        "$ref": "#/$defs/SessionRowV1"
      },
      "minItems": 1,
      "title": "Sessions",
      "type": "array",
      "uniqueItems": true
    },
    "state": {
      "enum": [
        "active",
        "paused",
        "complete"
      ],
      "title": "State",
      "type": "string"
    },
    "store_id": {
      "pattern": "^store-[0-9a-f]{32}$",
      "title": "Store Id",
      "type": "string"
    },
    "taxonomy": {
      "$ref": "#/$defs/TaxonomyRef"
    },
    "updated_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "collection_id",
    "dataset_id",
    "dataset_version",
    "store_id",
    "inventory_id",
    "generated_at",
    "updated_at",
    "finalized_at",
    "state",
    "fixture_only",
    "taxonomy",
    "protocol",
    "governance_policy",
    "participants",
    "sessions",
    "session_plans",
    "occurrences",
    "annotations",
    "collection_sidecar_sha256"
  ],
  "title": "CollectionSidecarV1",
  "type": "object"
}
