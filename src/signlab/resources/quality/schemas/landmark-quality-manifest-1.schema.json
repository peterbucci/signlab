{
  "$comment": "This JSON Schema enforces portable landmark-quality structure. SignLab's strict quality validators remain authoritative for canonical hashes, metric directions, severity ordering, gap decisions, weighted aggregates, elapsed-time grids, and extraction bindings.",
  "$defs": {
    "DatasetQualityReportV1": {
      "additionalProperties": false,
      "description": "Weighted aggregate over every sequence disposition and denominator.",
      "properties": {
        "expected_hand_coverage_ppm": {
          "le": 1000000,
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Expected Hand Coverage Ppm",
          "type": "integer"
        },
        "invalid_frame_fraction_ppm": {
          "le": 1000000,
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Invalid Frame Fraction Ppm",
          "type": "integer"
        },
        "longest_unfilled_internal_hand_gap_us": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Longest Unfilled Internal Hand Gap Us",
          "type": "integer"
        },
        "minimum_pose_anchor_coverage_ppm": {
          "le": 1000000,
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Minimum Pose Anchor Coverage Ppm",
          "type": "integer"
        },
        "pass_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Pass Count",
          "type": "integer"
        },
        "quarantine_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Quarantine Count",
          "type": "integer"
        },
        "reject_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Reject Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "dataset-quality-report/1",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence_count": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Sequence Count",
          "type": "integer"
        },
        "status": {
          "enum": [
            "ready",
            "ready_with_warnings",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        },
        "suspected_hand_swap_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Suspected Hand Swap Count",
          "type": "integer"
        },
        "temporal_discontinuity_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Temporal Discontinuity Count",
          "type": "integer"
        },
        "timestamp_discontinuity_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Timestamp Discontinuity Count",
          "type": "integer"
        },
        "total_expected_hand_observation_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Total Expected Hand Observation Count",
          "type": "integer"
        },
        "total_expected_hand_opportunity_count": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Total Expected Hand Opportunity Count",
          "type": "integer"
        },
        "total_frame_count": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Total Frame Count",
          "type": "integer"
        },
        "total_invalid_frame_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Total Invalid Frame Count",
          "type": "integer"
        },
        "warning_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Warning Count",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "sequence_count",
        "pass_count",
        "warning_count",
        "quarantine_count",
        "reject_count",
        "total_frame_count",
        "total_invalid_frame_count",
        "invalid_frame_fraction_ppm",
        "total_expected_hand_observation_count",
        "total_expected_hand_opportunity_count",
        "expected_hand_coverage_ppm",
        "minimum_pose_anchor_coverage_ppm",
        "longest_unfilled_internal_hand_gap_us",
        "timestamp_discontinuity_count",
        "temporal_discontinuity_count",
        "suspected_hand_swap_count",
        "status"
      ],
      "title": "DatasetQualityReportV1",
      "type": "object"
    },
    "LandmarkQualityPolicyV1": {
      "additionalProperties": false,
      "description": "Fully resolved quality, gap, timing, and swap-diagnostic policy.",
      "properties": {
        "expected_hand_cardinality_rule": {
          "const": "recording_handedness_unknown_means_one",
          "title": "Expected Hand Cardinality Rule",
          "type": "string"
        },
        "extrapolation_allowed": {
          "const": false,
          "title": "Extrapolation Allowed",
          "type": "boolean"
        },
        "handedness_confidence_diagnostic_ppm": {
          "le": 1000000,
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Handedness Confidence Diagnostic Ppm",
          "type": "integer"
        },
        "interpolation_method": {
          "const": "linear_coordinates_only",
          "title": "Interpolation Method",
          "type": "string"
        },
        "max_interpolated_missing_frames": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Max Interpolated Missing Frames",
          "type": "integer"
        },
        "max_interpolation_bridge_us": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Max Interpolation Bridge Us",
          "type": "integer"
        },
        "max_palm_wrist_speed_units_per_second": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Max Palm Wrist Speed Units Per Second",
          "type": "integer"
        },
        "policy_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Policy Id",
          "type": "string"
        },
        "pose_presence_diagnostic_ppm": {
          "le": 1000000,
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Pose Presence Diagnostic Ppm",
          "type": "integer"
        },
        "pose_visibility_diagnostic_ppm": {
          "le": 1000000,
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Pose Visibility Diagnostic Ppm",
          "type": "integer"
        },
        "resampling_rule": {
          "const": "nominal_elapsed_time_append_final/1",
          "title": "Resampling Rule",
          "type": "string"
        },
        "schema_version": {
          "const": "landmark-quality-policy/1",
          "title": "Schema Version",
          "type": "string"
        },
        "suspected_swap_cost_margin_ppm": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Suspected Swap Cost Margin Ppm",
          "type": "integer"
        },
        "target_rate_denominator": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Target Rate Denominator",
          "type": "integer"
        },
        "target_rate_numerator": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Target Rate Numerator",
          "type": "integer"
        },
        "threshold_rules": {
          "items": {
            "$ref": "#/$defs/QualityThresholdRuleV1"
          },
          "maxItems": 8,
          "minItems": 8,
          "title": "Threshold Rules",
          "type": "array",
          "uniqueItems": true
        },
        "timestamp_discontinuity_absolute_us": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Timestamp Discontinuity Absolute Us",
          "type": "integer"
        },
        "timestamp_discontinuity_median_multiplier_ppm": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Timestamp Discontinuity Median Multiplier Ppm",
          "type": "integer"
        },
        "version": {
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "policy_id",
        "version",
        "expected_hand_cardinality_rule",
        "target_rate_numerator",
        "target_rate_denominator",
        "resampling_rule",
        "interpolation_method",
        "extrapolation_allowed",
        "max_interpolated_missing_frames",
        "max_interpolation_bridge_us",
        "handedness_confidence_diagnostic_ppm",
        "pose_visibility_diagnostic_ppm",
        "pose_presence_diagnostic_ppm",
        "timestamp_discontinuity_absolute_us",
        "timestamp_discontinuity_median_multiplier_ppm",
        "suspected_swap_cost_margin_ppm",
        "max_palm_wrist_speed_units_per_second",
        "threshold_rules"
      ],
      "title": "LandmarkQualityPolicyV1",
      "type": "object"
    },
    "MissingIntervalV1": {
      "additionalProperties": false,
      "description": "One absent signal run and its explicit interpolation or preservation decision.",
      "properties": {
        "boundary": {
          "enum": [
            "leading",
            "internal",
            "trailing",
            "entire_sequence"
          ],
          "title": "Boundary",
          "type": "string"
        },
        "contains_identity_ambiguity": {
          "title": "Contains Identity Ambiguity",
          "type": "boolean"
        },
        "contains_invalid_frame": {
          "title": "Contains Invalid Frame",
          "type": "boolean"
        },
        "crosses_suspected_hand_swap": {
          "title": "Crosses Suspected Hand Swap",
          "type": "boolean"
        },
        "crosses_timestamp_discontinuity": {
          "title": "Crosses Timestamp Discontinuity",
          "type": "boolean"
        },
        "decision": {
          "enum": [
            "interpolate_linear",
            "preserve_missing"
          ],
          "title": "Decision",
          "type": "string"
        },
        "duration_us": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Duration Us",
          "type": "integer"
        },
        "first_missing_frame_index": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "First Missing Frame Index",
          "type": "integer"
        },
        "first_missing_timestamp_us": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "First Missing Timestamp Us",
          "type": "integer"
        },
        "gap_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Gap Id",
          "type": "string"
        },
        "last_missing_frame_index": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Last Missing Frame Index",
          "type": "integer"
        },
        "last_missing_timestamp_us": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Last Missing Timestamp Us",
          "type": "integer"
        },
        "left_observed_frame_index": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Left Observed Frame Index"
        },
        "left_observed_timestamp_us": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Left Observed Timestamp Us"
        },
        "missing_frame_count": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Missing Frame Count",
          "type": "integer"
        },
        "reasons": {
          "items": {
            "enum": [
              "bridge_too_long",
              "eligible_short_internal_gap",
              "entire_sequence_missing",
              "identity_ambiguity",
              "invalid_frame",
              "leading_gap",
              "low_confidence",
              "timestamp_discontinuity",
              "too_many_missing_frames",
              "trailing_gap"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array",
          "uniqueItems": true
        },
        "right_observed_frame_index": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Right Observed Frame Index"
        },
        "right_observed_timestamp_us": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Right Observed Timestamp Us"
        },
        "schema_version": {
          "const": "missing-interval/1",
          "title": "Schema Version",
          "type": "string"
        },
        "signal": {
          "anyOf": [
            {
              "enum": [
                "hand_0",
                "hand_1"
              ],
              "type": "string"
            },
            {
              "enum": [
                "left_shoulder",
                "right_shoulder",
                "left_elbow",
                "right_elbow",
                "left_wrist",
                "right_wrist"
              ],
              "type": "string"
            }
          ],
          "title": "Signal"
        }
      },
      "required": [
        "schema_version",
        "gap_id",
        "signal",
        "boundary",
        "first_missing_frame_index",
        "last_missing_frame_index",
        "first_missing_timestamp_us",
        "last_missing_timestamp_us",
        "missing_frame_count",
        "duration_us",
        "left_observed_frame_index",
        "left_observed_timestamp_us",
        "right_observed_frame_index",
        "right_observed_timestamp_us",
        "contains_invalid_frame",
        "contains_identity_ambiguity",
        "crosses_timestamp_discontinuity",
        "crosses_suspected_hand_swap",
        "decision",
        "reasons"
      ],
      "title": "MissingIntervalV1",
      "type": "object"
    },
    "QualityFindingV1": {
      "additionalProperties": false,
      "description": "The highest configured threshold violation for one quality metric.",
      "properties": {
        "direction": {
          "enum": [
            "higher_is_worse",
            "lower_is_worse"
          ],
          "title": "Direction",
          "type": "string"
        },
        "metric": {
          "enum": [
            "expected_hand_coverage_ppm",
            "invalid_frame_fraction_ppm",
            "longest_unfilled_internal_hand_gap_us",
            "low_handedness_confidence_fraction_ppm",
            "minimum_pose_anchor_coverage_ppm",
            "suspected_hand_swap_count",
            "temporal_discontinuity_count",
            "timestamp_discontinuity_count"
          ],
          "title": "Metric",
          "type": "string"
        },
        "observed_value": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Observed Value",
          "type": "integer"
        },
        "rule_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Rule Id",
          "type": "string"
        },
        "schema_version": {
          "const": "quality-finding/1",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "warning",
            "quarantine",
            "reject"
          ],
          "title": "Severity",
          "type": "string"
        },
        "threshold": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Threshold",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "rule_id",
        "metric",
        "direction",
        "severity",
        "observed_value",
        "threshold"
      ],
      "title": "QualityFindingV1",
      "type": "object"
    },
    "QualityThresholdRuleV1": {
      "additionalProperties": false,
      "description": "Optional warning/quarantine/reject limits for one registered integer metric.",
      "properties": {
        "direction": {
          "enum": [
            "higher_is_worse",
            "lower_is_worse"
          ],
          "title": "Direction",
          "type": "string"
        },
        "metric": {
          "enum": [
            "expected_hand_coverage_ppm",
            "invalid_frame_fraction_ppm",
            "longest_unfilled_internal_hand_gap_us",
            "low_handedness_confidence_fraction_ppm",
            "minimum_pose_anchor_coverage_ppm",
            "suspected_hand_swap_count",
            "temporal_discontinuity_count",
            "timestamp_discontinuity_count"
          ],
          "title": "Metric",
          "type": "string"
        },
        "quarantine": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quarantine"
        },
        "reject": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reject"
        },
        "rule_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
          "title": "Rule Id",
          "type": "string"
        },
        "schema_version": {
          "const": "quality-threshold-rule/1",
          "title": "Schema Version",
          "type": "string"
        },
        "warning": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Warning"
        }
      },
      "required": [
        "schema_version",
        "rule_id",
        "metric",
        "direction",
        "warning",
        "quarantine",
        "reject"
      ],
      "title": "QualityThresholdRuleV1",
      "type": "object"
    },
    "SequenceQualityMetricsV1": {
      "additionalProperties": false,
      "description": "Integer, denominator-carrying quality metrics for one recording sequence.",
      "properties": {
        "expected_hand_count": {
          "enum": [
            1,
            2
          ],
          "title": "Expected Hand Count",
          "type": "integer"
        },
        "expected_hand_coverage_ppm": {
          "le": 1000000,
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Expected Hand Coverage Ppm",
          "type": "integer"
        },
        "expected_hand_observation_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Expected Hand Observation Count",
          "type": "integer"
        },
        "expected_hand_opportunity_count": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Expected Hand Opportunity Count",
          "type": "integer"
        },
        "frame_count": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Frame Count",
          "type": "integer"
        },
        "handedness_confidence_observation_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Handedness Confidence Observation Count",
          "type": "integer"
        },
        "interpolated_gap_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Interpolated Gap Count",
          "type": "integer"
        },
        "invalid_frame_fraction_ppm": {
          "le": 1000000,
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Invalid Frame Fraction Ppm",
          "type": "integer"
        },
        "longest_unfilled_internal_hand_gap_us": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Longest Unfilled Internal Hand Gap Us",
          "type": "integer"
        },
        "low_handedness_confidence_fraction_ppm": {
          "anyOf": [
            {
              "le": 1000000,
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Low Handedness Confidence Fraction Ppm"
        },
        "low_handedness_confidence_observation_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Low Handedness Confidence Observation Count",
          "type": "integer"
        },
        "low_pose_confidence_observation_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Low Pose Confidence Observation Count",
          "type": "integer"
        },
        "maximum_timestamp_delta_us": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Maximum Timestamp Delta Us"
        },
        "median_timestamp_delta_us": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Median Timestamp Delta Us"
        },
        "minimum_pose_anchor_coverage_ppm": {
          "le": 1000000,
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Minimum Pose Anchor Coverage Ppm",
          "type": "integer"
        },
        "pose_anchor_coverage_ppm": {
          "maxItems": 6,
          "minItems": 6,
          "prefixItems": [
            {
              "le": 1000000,
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "le": 1000000,
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "le": 1000000,
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "le": 1000000,
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "le": 1000000,
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "le": 1000000,
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          ],
          "title": "Pose Anchor Coverage Ppm",
          "type": "array"
        },
        "pose_anchor_presence_counts": {
          "maxItems": 6,
          "minItems": 6,
          "prefixItems": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          ],
          "title": "Pose Anchor Presence Counts",
          "type": "array"
        },
        "pose_confidence_observation_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Pose Confidence Observation Count",
          "type": "integer"
        },
        "preserved_gap_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Preserved Gap Count",
          "type": "integer"
        },
        "source_invalid_frame_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Source Invalid Frame Count",
          "type": "integer"
        },
        "suspected_hand_swap_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Suspected Hand Swap Count",
          "type": "integer"
        },
        "task_inference_failed_frame_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Task Inference Failed Frame Count",
          "type": "integer"
        },
        "temporal_discontinuity_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Temporal Discontinuity Count",
          "type": "integer"
        },
        "timestamp_delta_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Timestamp Delta Count",
          "type": "integer"
        },
        "timestamp_discontinuity_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Timestamp Discontinuity Count",
          "type": "integer"
        },
        "valid_frame_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Valid Frame Count",
          "type": "integer"
        }
      },
      "required": [
        "frame_count",
        "valid_frame_count",
        "source_invalid_frame_count",
        "task_inference_failed_frame_count",
        "invalid_frame_fraction_ppm",
        "expected_hand_count",
        "expected_hand_observation_count",
        "expected_hand_opportunity_count",
        "expected_hand_coverage_ppm",
        "handedness_confidence_observation_count",
        "low_handedness_confidence_observation_count",
        "low_handedness_confidence_fraction_ppm",
        "pose_anchor_presence_counts",
        "pose_anchor_coverage_ppm",
        "minimum_pose_anchor_coverage_ppm",
        "pose_confidence_observation_count",
        "low_pose_confidence_observation_count",
        "interpolated_gap_count",
        "preserved_gap_count",
        "longest_unfilled_internal_hand_gap_us",
        "timestamp_delta_count",
        "median_timestamp_delta_us",
        "maximum_timestamp_delta_us",
        "timestamp_discontinuity_count",
        "temporal_discontinuity_count",
        "suspected_hand_swap_count"
      ],
      "title": "SequenceQualityMetricsV1",
      "type": "object"
    },
    "SequenceQualityReportV1": {
      "additionalProperties": false,
      "description": "One recording-level report without sample, split, feature, or path identity.",
      "properties": {
        "disposition": {
          "enum": [
            "pass",
            "warning",
            "quarantine",
            "reject"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/QualityFindingV1"
          },
          "title": "Findings",
          "type": "array",
          "uniqueItems": true
        },
        "gaps": {
          "items": {
            "$ref": "#/$defs/MissingIntervalV1"
          },
          "title": "Gaps",
          "type": "array",
          "uniqueItems": true
        },
        "metrics": {
          "$ref": "#/$defs/SequenceQualityMetricsV1"
        },
        "policy_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "report_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Report Sha256",
          "type": "string"
        },
        "resampling": {
          "$ref": "#/$defs/TemporalResamplingSummaryV1"
        },
        "schema_version": {
          "const": "sequence-quality-report/1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_landmark_parquet_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Landmark Parquet Sha256",
          "type": "string"
        },
        "source_recording_id": {
          "pattern": "^recording_[0-9a-f]{32}$",
          "title": "Source Recording Id",
          "type": "string"
        },
        "source_sequence_content_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Sequence Content Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "source_recording_id",
        "source_sequence_content_sha256",
        "source_landmark_parquet_sha256",
        "policy_sha256",
        "metrics",
        "gaps",
        "resampling",
        "findings",
        "disposition",
        "report_sha256"
      ],
      "title": "SequenceQualityReportV1",
      "type": "object"
    },
    "TemporalResamplingSummaryV1": {
      "additionalProperties": false,
      "description": "Compact evidence for a duration-preserving elapsed-time target grid.",
      "properties": {
        "clock": {
          "const": "relative_timestamp_us",
          "title": "Clock",
          "type": "string"
        },
        "declared_duration_us": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Declared Duration Us",
          "type": "integer"
        },
        "declared_unobserved_tail_decision": {
          "const": "preserve_missing",
          "title": "Declared Unobserved Tail Decision",
          "type": "string"
        },
        "declared_unobserved_tail_us": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Declared Unobserved Tail Us",
          "type": "integer"
        },
        "first_target_timestamp_us": {
          "const": 0,
          "title": "First Target Timestamp Us",
          "type": "integer"
        },
        "grid_rule": {
          "const": "nominal_elapsed_time_append_final/1",
          "title": "Grid Rule",
          "type": "string"
        },
        "last_target_timestamp_us": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Last Target Timestamp Us",
          "type": "integer"
        },
        "observed_span_us": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Observed Span Us",
          "type": "integer"
        },
        "schema_version": {
          "const": "temporal-resampling-summary/1",
          "title": "Schema Version",
          "type": "string"
        },
        "target_count": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Target Count",
          "type": "integer"
        },
        "target_grid_commitment_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Target Grid Commitment Sha256",
          "type": "string"
        },
        "target_rate_denominator": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Target Rate Denominator",
          "type": "integer"
        },
        "target_rate_numerator": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Target Rate Numerator",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "clock",
        "grid_rule",
        "target_rate_numerator",
        "target_rate_denominator",
        "declared_duration_us",
        "observed_span_us",
        "declared_unobserved_tail_us",
        "declared_unobserved_tail_decision",
        "target_count",
        "first_target_timestamp_us",
        "last_target_timestamp_us",
        "target_grid_commitment_sha256"
      ],
      "title": "TemporalResamplingSummaryV1",
      "type": "object"
    }
  },
  "$id": "https://signlab.dev/schemas/landmark-quality-manifest-1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Self-digested quality handoff bound to extraction, raw data, and policy.",
  "properties": {
    "dataset_report": {
      "$ref": "#/$defs/DatasetQualityReportV1"
    },
    "extraction_config_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Extraction Config Sha256",
      "type": "string"
    },
    "extraction_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
      "title": "Extraction Id",
      "type": "string"
    },
    "extraction_manifest_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Extraction Manifest Sha256",
      "type": "string"
    },
    "extraction_version": {
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Extraction Version",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/LandmarkQualityPolicyV1"
    },
    "policy_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "quality_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
      "title": "Quality Id",
      "type": "string"
    },
    "raw_data_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Raw Data Sha256",
      "type": "string"
    },
    "raw_dataset_id": {
      "pattern": "^dataset_[0-9a-f]{32}$",
      "title": "Raw Dataset Id",
      "type": "string"
    },
    "raw_dataset_manifest_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Raw Dataset Manifest Sha256",
      "type": "string"
    },
    "raw_dataset_version": {
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Raw Dataset Version",
      "type": "string"
    },
    "schema_version": {
      "const": "landmark-quality-manifest/1",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence_reports": {
      "items": {
        "$ref": "#/$defs/SequenceQualityReportV1"
      },
      "minItems": 1,
      "title": "Sequence Reports",
      "type": "array",
      "uniqueItems": true
    },
    "version": {
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "quality_id",
    "version",
    "raw_dataset_id",
    "raw_dataset_version",
    "raw_data_sha256",
    "raw_dataset_manifest_sha256",
    "extraction_id",
    "extraction_version",
    "extraction_manifest_sha256",
    "extraction_config_sha256",
    "policy",
    "policy_sha256",
    "sequence_reports",
    "dataset_report",
    "manifest_sha256"
  ],
  "title": "LandmarkQualityManifestV1",
  "type": "object"
}
